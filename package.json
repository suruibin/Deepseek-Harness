{
  "name": "dsh-desktop-electron",
  "description": "Electron desktop shell for the DeepSeek Harness Web GUI: spawns dsh web and hosts it in a standalone window with tray residency",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/main.js",
  "license": "BSD-3-Clause",
  "scripts": {
    "build": "node node_modules/typescript/bin/tsc -p tsconfig.json",
    "watch": "node node_modules/typescript/bin/tsc -p tsconfig.json --watch",
    "dev": "npm run build && node scripts/run-electron.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "test": "node node_modules/vitest/vitest.mjs run",
    "typecheck": "node node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "dist": "npm run build && node node_modules/electron-builder/cli.js --config electron-builder.yml",
    "dist:dir": "npm run build && node node_modules/electron-builder/cli.js --config electron-builder.yml --dir",
    "repair": "node scripts/repair-session-log.mjs"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.0.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "node-pty": "^1.1.0",
    "xterm": "^5.3.0"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
